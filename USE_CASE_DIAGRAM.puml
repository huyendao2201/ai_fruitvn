@startuml USE_CASE_DIAGRAM
!theme plain
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor<<User>> LightBlue
    BackgroundColor<<Admin>> LightCoral
    BackgroundColor<<AI>> LightGreen
    BorderColor Black
    ArrowColor Black
}

title Sơ Đồ Use Case - Hệ Thống Nhận Diện Trái Cây Việt Nam

left to right direction

actor "👤 Người Dùng\n(User)" as User #LightBlue
actor "👨‍💼 Quản Trị Viên\n(Admin)" as Admin #LightCoral
actor "🤖 Hệ Thống AI\n(AI Model)" as AI #LightGreen

rectangle "Hệ Thống Nhận Diện Trái Cây" {
    
    ' ==================== NHÓM NGƯỜI DÙNG ====================
    package "Chức Năng Người Dùng" #LightBlue {
        usecase "UC-01\nChụp/Chọn Ảnh\nTrái Cây" as UC01 <<User>>
        usecase "UC-02\nNhận Diện\nTrái Cây Bằng AI" as UC02 <<User>>
        usecase "UC-03\nXem Kết Quả\nDự Đoán" as UC03 <<User>>
        usecase "UC-04\nGửi Phản Hồi\n(Feedback)" as UC04 <<User>>
        
        UC01 .down.> UC02 : <<include>>
        UC02 .down.> UC03 : <<include>>
        UC03 .down.> UC04 : <<extend>>
    }
    
    ' ==================== NHÓM ADMIN ====================
    package "Chức Năng Quản Trị" #LightCoral {
        usecase "UC-05\nĐăng Nhập\nAdmin" as UC05 <<Admin>>
        usecase "UC-06\nXem Dashboard\nThống Kê" as UC06 <<Admin>>
        usecase "UC-07\nQuản Lý\nLịch Sử Dự Đoán" as UC07 <<Admin>>
        usecase "UC-08\nQuản Lý\nPhản Hồi" as UC08 <<Admin>>
        usecase "UC-08a\nĐánh Dấu\nĐã Xem" as UC08a <<Admin>>
        usecase "UC-08b\nĐánh Dấu\nTất Cả Đã Xem" as UC08b <<Admin>>
        usecase "UC-08c\nThêm Ảnh Vào\nTraining Dataset" as UC08c <<Admin>>
        usecase "UC-09\nXem Training\nLogs" as UC09 <<Admin>>
        usecase "UC-10\nĐăng Xuất" as UC10 <<Admin>>
        
        UC08 .down.> UC08a : <<include>>
        UC08 .down.> UC08b : <<include>>
        UC08 .down.> UC08c : <<include>>
        
        UC05 ..> UC06 : <<precedes>>
        UC06 ..> UC07 : <<extend>>
        UC06 ..> UC08 : <<extend>>
        UC06 ..> UC09 : <<extend>>
    }
    
    ' ==================== NHÓM HỆ THỐNG AI ====================
    package "Chức Năng Hệ Thống" #LightGreen {
        usecase "UC-11\nHuấn Luyện\nMô Hình AI" as UC11 <<AI>>
    }
}

' ==================== QUAN HỆ ACTORS ====================
User --> UC01 : "Chụp/Chọn ảnh"
User --> UC02 : "Yêu cầu\nnhận diện"
User --> UC03 : "Xem kết quả"
User --> UC04 : "Đánh giá\nkết quả"

Admin --> UC05 : "Đăng nhập"
Admin --> UC06 : "Xem thống kê"
Admin --> UC07 : "Xem lịch sử"
Admin --> UC08 : "Quản lý\nphản hồi"
Admin --> UC09 : "Xem logs"
Admin --> UC10 : "Đăng xuất"

AI --> UC02 : "Xử lý\nnhận diện"
AI --> UC11 : "Training\nmô hình"

' ==================== NOTES ====================
note right of User
  **Người Dùng Thông Thường**
  - Không cần đăng nhập
  - Sử dụng app Flutter
  - Nhận diện trái cây
  - Gửi phản hồi
end note

note right of Admin
  **Quản Trị Viên**
  - Cần đăng nhập (JWT)
  - Username: admin
  - Password: admin123
  - Quản lý toàn bộ hệ thống
end note

note right of AI
  **Hệ Thống AI**
  - Mô hình CNN
  - 10 loại trái cây
  - Độ chính xác: ~90%
  - TensorFlow/Keras
end note

note bottom of "Hệ Thống Nhận Diện Trái Cây"
  **Công Nghệ:**
  • Frontend: Flutter (Dart)
  • Backend: Flask (Python)
  • Database: MySQL
  • AI: TensorFlow/Keras CNN
  • Auth: JWT Token
  
  **10 Loại Trái Cây:**
  1. Bưởi Da Xanh Bến Tre
  2. Cam Sành Hà Giang
  3. Chôm Chôm Long Khánh
  4. Măng Cụt Lái Thiêu
  5. Nhãn Lồng Hưng Yên
  6. Sầu Riêng Ri6
  7. Thanh Long Bình Thuận
  8. Vải Thiều Lục Ngạn
  9. Vú Sữa Lò Rèn
  10. Xoài Cát Hòa Lộc
end note

legend right
  |<#LightBlue> UC-XX | Chức năng Người dùng |
  |<#LightCoral> UC-XX | Chức năng Quản trị |
  |<#LightGreen> UC-XX | Chức năng Hệ thống |
  
  **Quan hệ:**
  ---> : Association (Sử dụng)
  ..> <<include>> : Bao gồm (Bắt buộc)
  ..> <<extend>> : Mở rộng (Tùy chọn)
  ..> <<precedes>> : Đi trước
endlegend

@enduml

